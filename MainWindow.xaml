<Window x:Class="Bili_Latiao_CSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bili_Latiao_CSharp"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        WindowStyle="None" AllowsTransparency="True"
        Topmost="False" ShowInTaskbar="True" ResizeMode="NoResize"
        Title="{Binding Title}" Height="811" Width="760"
        Icon="logo.ico"
        Background="Transparent">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:InvertBoolConverter x:Key="InvertBoolConverter"/>

        <!-- 圆角按钮样式 -->
        <Style x:Key="RoundedBtn" TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 圆角输入框 -->
        <Style x:Key="RoundedInput" TargetType="TextBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="#FFF5F5F5"/>
            <Setter Property="Foreground" Value="#FF333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FFD9D9D9"/>
            <Setter Property="CaretBrush" Value="#FF333333"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="4" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#FF1677FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 主按钮 -->
        <Style x:Key="PrimaryBtn" BasedOn="{StaticResource RoundedBtn}" TargetType="Button">
            <Setter Property="Background" Value="#FF1677FF"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
        </Style>

        <!-- 红色按钮 -->
        <Style x:Key="DangerBtn" BasedOn="{StaticResource RoundedBtn}" TargetType="Button">
            <Setter Property="Background" Value="#FFF5222D"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" Background="#FFF5F7FA" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.15" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="#FFFFFFFF"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="15,0,0,0">
                    <Image Source="logo.ico" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding Title}"
                               Foreground="#FF333333" FontSize="14"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="─" Style="{StaticResource RoundedBtn}"
                            Click="MinimizeBtn_Click"
                            Width="36" Height="28" Padding="0"
                            Background="Transparent" Foreground="#FF666666"
                            FontSize="14"/>
                    <Button Content="✕" Style="{StaticResource RoundedBtn}"
                            Command="{Binding CloseCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            Width="36" Height="28" Padding="0"
                            Background="Transparent" Foreground="#FF666666"
                            FontSize="14"/>
                </StackPanel>
            </Grid>

            <!-- 内容区：左右双栏 -->
            <Grid Grid.Row="1" Margin="15,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="19"/>
                    <ColumnDefinition Width="354"/>
                </Grid.ColumnDefinitions>

                <!-- 左栏：功能卡片 -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- 用户信息 -->
                        <Border Background="#FFFFFFFF" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="用户信息" Foreground="#FF1677FF" FontWeight="Bold" FontSize="15" Margin="0,0,0,6"/>
                                <TextBlock Foreground="#FF333333" FontSize="12">
                                    <Run Text="用户："/><Run Text="{Binding UserName, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Foreground="#FF888888" FontSize="12" Margin="0,3,0,0">
                                    <Run Text="状态："/><Run Text="{Binding StatusMessage, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- 登录 -->
                        <Border Background="#FFFFFFFF" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="登录" Foreground="#FF1677FF" FontWeight="Bold" FontSize="15" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="扫码登录" Style="{StaticResource PrimaryBtn}"
                                            Command="{Binding LoginCommand}"
                                            IsEnabled="{Binding IsLoggingIn, Converter={StaticResource InvertBoolConverter}}"
                                            Margin="0,0,10,0"/>
                                    <Button Content="取消" Style="{StaticResource DangerBtn}"
                                            Command="{Binding CancelLoginCommand}"
                                            Visibility="{Binding IsLoggingIn, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                                <Border Height="180" Width="180" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <Image Source="{Binding QrcodeImage}"
                                           Visibility="{Binding IsLoggingIn, Converter={StaticResource BoolToVisibilityConverter}}"
                                           MaxHeight="180" MaxWidth="180"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 直播间 -->
                        <Border Background="#FFFFFFFF" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="直播间" Foreground="#FF1677FF" FontWeight="Bold" FontSize="15" Margin="0,0,0,6"/>
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="房间号：" Foreground="#FF333333" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding RoomId, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="208" Style="{StaticResource RoundedInput}"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- 辣条 -->
                        <Border Background="#FFFFFFFF" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="辣条" Foreground="#FF1677FF" FontWeight="Bold" FontSize="15" Margin="0,0,0,6"/>
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Content="赠送" Style="{StaticResource PrimaryBtn}"
                                                Command="{Binding SendLatiaoCommand}"
                                                IsEnabled="{Binding IsOperating, Converter={StaticResource InvertBoolConverter}}"
                                                Margin="10,0,5,0"/>
                                        <Button Content="循环" Style="{StaticResource PrimaryBtn}"
                                                Command="{Binding SendLatiaoLoopCommand}"
                                                IsEnabled="{Binding IsOperating, Converter={StaticResource InvertBoolConverter}}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="数量：" Foreground="#FF333333" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding LatiaoNum, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="90" Style="{StaticResource RoundedInput}"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- 点赞 -->
                        <Border Background="#FFFFFFFF" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="点赞" Foreground="#FF1677FF" FontWeight="Bold" FontSize="15" Margin="0,0,0,6"/>
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Content="一次点满" Style="{StaticResource PrimaryBtn}"
                                                Command="{Binding LikeOnceCommand}"
                                                IsEnabled="{Binding IsOperating, Converter={StaticResource InvertBoolConverter}}"
                                                Margin="10,0,5,0"/>
                                        <Button Content="模拟" Style="{StaticResource PrimaryBtn}"
                                                Command="{Binding LikeSimulateCommand}"
                                                IsEnabled="{Binding IsOperating, Converter={StaticResource InvertBoolConverter}}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="数量：" Foreground="#FF333333" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding LikeNum, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="90" Style="{StaticResource RoundedInput}"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- 停止操作 -->
                        <Border Background="#FFFFFFFF" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <Button Content="停止操作" Style="{StaticResource DangerBtn}"
                                        Command="{Binding StopOperationCommand}"
                                        IsEnabled="{Binding IsOperating}"
                                        Height="32" FontSize="13"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- 右栏：日志 -->
                <Border Grid.Column="2" Background="#FFFFFFFF" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="日志" Foreground="#FF1677FF" FontWeight="Bold" FontSize="15" Margin="0,0,0,6"/>
                        <ListBox ItemsSource="{Binding LogMessages}"
                                 Background="#FFF5F5F5"
                                 Foreground="#FF555555" BorderThickness="0"
                                 FontSize="10" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
